{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-factory.local/schemas/higgsfield-routing-request.schema.json",
  "title": "HIGGSFIELD_ROUTING_REQUEST",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "version", "request_id", "intent", "brief", "inputs", "delivery", "priorities"],
  "properties": {
    "contract": { "const": "HIGGSFIELD_ROUTING_REQUEST" },
    "version": { "const": "0.1.0" },
    "request_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "intent": {
      "enum": ["motion_transfer", "element_swap", "cinematic_sequence", "marketing_video", "viral_effect", "video_edit", "ad_variants", "virality_analysis", "youtube_clips"]
    },
    "brief": { "type": "string", "minLength": 1 },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reference_video": { "type": "string", "minLength": 1 },
        "reference_images": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "character_pack_ref": { "type": "string", "minLength": 1 },
        "product_pack_ref": { "type": "string", "minLength": 1 },
        "sequence_continuity_ref": { "type": "string", "minLength": 1 },
        "shot_plan_ref": { "type": "string", "minLength": 1 },
        "approved_keyframe": { "type": "string", "minLength": 1 },
        "product_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "avatar_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "storyboard_id": { "type": "string", "minLength": 1 },
        "youtube_url": { "type": "string", "pattern": "^https?://" },
        "preset_name": { "type": "string", "minLength": 1 },
        "swap_target": { "type": "string", "minLength": 1 },
        "replacement_ref": { "type": "string", "minLength": 1 }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aspect_ratio", "resolution"],
      "properties": {
        "aspect_ratio": { "enum": ["21:9", "16:9", "4:3", "1:1", "3:4", "9:16", "auto"] },
        "resolution": { "enum": ["480p", "720p", "1080p"] },
        "duration_s": { "type": "integer", "minimum": 1 },
        "generate_audio": { "type": "boolean" }
      }
    },
    "priorities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["identity", "motion", "camera", "timing", "objects", "location", "script", "cost", "speed"] }
    }
  }
}
