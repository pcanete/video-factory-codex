{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/video-factory/keyframe-test.schema.json",
  "title": "KEYFRAME_TEST",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "test_id",
    "shot_plan_ref",
    "shot_index",
    "character_pack_refs",
    "reference_ids",
    "hypothesis",
    "generation",
    "evaluation",
    "gate"
  ],
  "properties": {
    "contract": {
      "const": "KEYFRAME_TEST"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "test_id": {
      "type": "string",
      "minLength": 1
    },
    "shot_plan_ref": {
      "type": "string",
      "minLength": 1
    },
    "shot_index": {
      "type": "integer",
      "minimum": 1
    },
    "frame_role": {
      "enum": [
        "start",
        "end"
      ],
      "default": "start"
    },
    "character_pack_refs": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reference_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question",
        "variables_held_constant"
      ],
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1
        },
        "variables_held_constant": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "prompt",
        "negative_prompt",
        "aspect_ratio",
        "candidate_path"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "negative_prompt": {
          "type": "string",
          "minLength": 1
        },
        "aspect_ratio": {
          "type": "string",
          "minLength": 1
        },
        "candidate_path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evaluation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dimension",
          "status",
          "note"
        ],
        "properties": {
          "dimension": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "review",
              "not_applicable"
            ]
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_status",
        "human_decision",
        "next_action"
      ],
      "properties": {
        "candidate_status": {
          "enum": [
            "draft",
            "candidate",
            "approved",
            "rejected"
          ]
        },
        "human_decision": {
          "enum": [
            "pending",
            "approved",
            "rejected"
          ]
        },
        "next_action": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "product_pack_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "anyOf": [
    {
      "properties": {
        "character_pack_refs": {
          "minItems": 1
        }
      },
      "required": [
        "character_pack_refs"
      ]
    },
    {
      "properties": {
        "product_pack_refs": {
          "minItems": 1
        }
      },
      "required": [
        "product_pack_refs"
      ]
    }
  ]
}
